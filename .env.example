# ---------------------------------------------------------------------------
# Caius Data — environment variables
# Copy to `.env.local` for local development. On Railway set these as
# service variables. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase --------------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private storage bucket that holds generated buyer-pack CSVs.
SUPABASE_EXPORT_BUCKET=order-exports

# Stripe ----------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the endpoint secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend ----------------------------------------------------------------------
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Caius Data <orders@mail.caiusdata.com>"
RESEND_REPLY_TO=support@caiusdata.com

# Site ------------------------------------------------------------------------
# Absolute origin used for Stripe redirect URLs and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
