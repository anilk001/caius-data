# ---------------------------------------------------------------------------
# Caius Data — environment variables
# Copy to `.env.local` for local development. On Railway set these as
# service variables. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase --------------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private storage bucket that holds generated buyer-pack CSVs.
SUPABASE_EXPORT_BUCKET=order-exports

# Stripe ----------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the endpoint secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend ----------------------------------------------------------------------
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Caius Data <orders@mail.caiusdata.com>"
RESEND_REPLY_TO=support@caiusdata.com

# Airtable (staging lane, optional) --------------------------------------------
# Only needed by scripts/ingest_csv.py --to-airtable and
# scripts/airtable_to_supabase.py. The web app never talks to Airtable.
# Token needs data.records:read, data.records:write, schema.bases:read.
AIRTABLE_API_KEY=pat_xxx
AIRTABLE_BASE_ID=app_xxx

# Site ------------------------------------------------------------------------
# Absolute origin used for Stripe redirect URLs, email links, robots and sitemap.
#
# Set SITE_URL on the server (Railway service variable). It is read at request
# time, so it is correct even if the build ran without it. NEXT_PUBLIC_SITE_URL
# is inlined at BUILD time and only used as a fallback.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
